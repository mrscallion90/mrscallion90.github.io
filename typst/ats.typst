#set page(
  paper: "a4",
  margin: 0.7in,
  numbering: none,
)

#set text(size: 10pt)
#set par(leading: 0.6em, spacing: 0.4em, justify: false)

// Section headings with rule underneath
#show heading.where(level: 1): it => {
  v(0.6em, weak: true)
  text(size: 12pt, weight: "bold")[#it.body]
  v(0.2em, weak: true)
  line(length: 100%, stroke: 0.5pt)
  v(0.3em, weak: true)
}

// Tight list spacing
#set list(
  indent: 1.2em,
  spacing: 0.2em,
  body-indent: 0.5em,
)

